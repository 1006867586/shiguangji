# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Cloudflare R2
R2_ACCOUNT_ID=your-account-id
R2_ACCESS_KEY_ID=your-access-key
R2_SECRET_ACCESS_KEY=your-secret-key
R2_BUCKET_NAME=xiangke-images
R2_PUBLIC_URL=https://img.xiangke.app

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# QQ 互联（可选，配置后登录页显示 QQ 登录按钮）
QQ_APP_ID=your-qq-app-id
QQ_APP_KEY=your-qq-app-key

# MiniMax AI（可选，配置后启用 AI 功能：截图识别/文案生成/邀请文案/账单识别）
# 申请: https://platform.minimaxi.com/
MINIMAX_API_KEY=your-minimax-api-key
# 可选，默认 https://api.minimaxi.com/v1
# MINIMAX_BASE_URL=https://api.minimaxi.com/v1
# 可选，文本对话模型，默认 MiniMax-M2.5-highspeed
# MINIMAX_MODEL=MiniMax-M2.5-highspeed
# 可选，多模态视觉模型，默认 MiniMax-M3
# MINIMAX_VISION_MODEL=MiniMax-M3
