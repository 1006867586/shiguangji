# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Cloudflare R2
R2_ACCOUNT_ID=your-account-id
R2_ACCESS_KEY_ID=your-access-key
R2_SECRET_ACCESS_KEY=your-secret-key
R2_BUCKET_NAME=xiangke-images
R2_PUBLIC_URL=https://img.xiangke.app

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# QQ 互联（可选，配置后登录页显示 QQ 登录按钮）
QQ_APP_ID=your-qq-app-id
QQ_APP_KEY=your-qq-app-key

# 微信小程序（可选，weapp 分支；配置后 /api/auth/weapp/* 可用）
# appid/secret 来自微信公众平台 → 开发管理 → 开发设置
WEAPP_APPID=your-weapp-appid
WEAPP_SECRET=your-weapp-secret

# MiniMax AI（可选，配置后启用 AI 功能：截图识别/文案生成/邀请文案/账单识别）
# 申请: https://platform.minimaxi.com/
MINIMAX_API_KEY=your-minimax-api-key
# OpenAI 兼容接口默认走 https://api.minimaxi.com/v1，无需手动设置。
# 如需覆盖，取消下行注释并修改：
# MINIMAX_BASE_URL=https://api.minimaxi.com/v1
# 可选，文本对话模型，默认 MiniMax-M2.5-highspeed
# MINIMAX_MODEL=MiniMax-M2.5-highspeed
# 可选，多模态视觉模型，默认 MiniMax-M3
# MINIMAX_VISION_MODEL=MiniMax-M3
# Anthropic 兼容接口（用于 web_search 服务端工具，联网搜索补齐店铺信息）
# 默认 https://api.minimaxi.com/anthropic，与 OpenAI 接口共用 MINIMAX_API_KEY
# MINIMAX_ANTHROPIC_BASE_URL=https://api.minimaxi.com/anthropic
# 可选，联网搜索使用的模型，默认 MiniMax-M3（M3 支持 web_search 服务端工具）
# MINIMAX_ANTHROPIC_MODEL=MiniMax-M3

# 地图 POI 检索（可选，配置后启用店铺名匹配补齐：电话/地址/坐标/评分/品类）
# 高德 Web 服务 Key，申请: https://console.amap.com/  （Key 类型必须选「Web 服务」）
AMAP_KEY=your-amap-web-service-key
# 百度地图服务端 AK，申请: https://lbsyun.baidu.com/  （应用类型选「服务端」）
BAIDU_MAP_AK=your-baidu-map-server-ak
# 百度 SN 校验密钥（与 AK 同步生成，控制台「设置」→「SN 校验」开启后获得）
# 百度服务端 AK 默认强制 SN 校验，必须同时配置 AK 和 SK，否则请求会被百度拒绝
BAIDU_MAP_SK=your-baidu-map-server-sk
